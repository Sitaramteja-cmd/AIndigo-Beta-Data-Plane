{
  "name": "aindigo-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev:data-plane": "npm run dev --workspace=@aindigo/data-plane",
    "dev:control-plane": "npm run dev --workspace=@aindigo/control-plane",
    "clean": "npm run clean --workspaces"
  },
  "devDependencies": {
    "typescript": "5.7.3"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0"
  }
}
